// Prisma schema for Tee to Green Golf — multi-tenant version.
// Default datasource is SQLite for easy local dev.
// For production on Vercel, switch provider to "postgresql" and set DATABASE_URL
// to a hosted Postgres instance (e.g. Vercel Postgres, Supabase, Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy ---

model Business {
  id     String @id @default(cuid())
  slug   String @unique // URL-friendly identifier, e.g. "tee-to-green" -> /tee-to-green/book
  name   String @default("My Golf Business")
  // IANA name (e.g. "America/Chicago"). Defaulted to the value every
  // existing business was already hardcoded to assume in lib/time.ts, so
  // this migration doesn't change anyone's actual behavior until they set
  // it explicitly in Settings.
  timezone String @default("America/New_York")
  // False for anything self-onboarded through /onboarding until the
  // platform admin approves it - a real safeguard against someone
  // spinning up a live, bookable business (and taking real payments)
  // with zero review at all.
  approved Boolean @default(false)

  // --- Platform billing (BookMyPro's own subscription, not this
  // business's own Stripe/Square setup for taking payments from their
  // players - a genuinely separate thing). A trial starts the moment a
  // business is approved, not the moment it's created, since an
  // unapproved business can't actually be used for anything yet.
  trialEndsAt      DateTime?
  subscriptionStatus String  @default("trial") // "trial" | "active" | "past_due" | "cancelled"
  platformStripeCustomerId     String?
  platformStripeSubscriptionId String?
  // The specific subscription line item for the per-instructor charge -
  // needed separately from the subscription id itself so its quantity
  // can be updated later without touching the base-fee line item at all.
  platformInstructorItemId     String?
  // Set once, the moment a trial's fate is genuinely decided one way or
  // the other by the platform admin - lets the admin review screen show
  // only what's actually still awaiting a decision.
  trialReviewedAt  DateTime?

  logoUrl String? // uploaded via Settings - shown on this business's own booking/instructor pages instead of the platform's generic branding
  email  String @default("")
  hours  String @default("Mon–Sat, 8:00 AM – 5:00 PM") // display-only text, shown on the booking page - not connected to actual calendar generation
  openHour  Int @default(8)  // 24-hour format - the actual hour the calendar starts generating slots from
  closeHour Int @default(17) // 24-hour format - the actual hour the calendar stops generating slots at (exclusive - e.g. 17 means the last slot is 4:00 PM, not 5:00 PM)
  lessonRate String @default("$120/hr")
  instructorName String? // shown to players as "with {instructorName}" — separate from the business name

  // Stripe Connect — each business gets its own connected account so payments
  // go directly to them. Null until they complete Stripe onboarding.
  // Each business picks one payment processor. Stripe fields are used when
  // paymentProvider is "stripe" (the default, for backward compatibility
  // with businesses that connected before Square support existed); Square
  // fields are used when it's "square".
  paymentProvider String  @default("stripe") // "stripe" | "square"
  stripeAccountId String?

  squareMerchantId     String?
  squareAccessToken    String?
  squareRefreshToken   String?
  squareTokenExpiresAt DateTime?

  packageSingleEnabled Boolean @default(true)
  packagePlayingEnabled Boolean @default(true)
  packageVideoEnabled  Boolean @default(true)
  packageThreeEnabled  Boolean @default(true)
  packageFiveEnabled   Boolean @default(true)
  packageTenEnabled    Boolean @default(true)

  packageSinglePriceCents Int @default(12000)
  packagePlayingPriceCents Int @default(0) // 0 = "TBD" — not yet priced by the instructor
  packageVideoPriceCents  Int @default(0) // 0 = "TBD" — open price, same convention as Playing lesson
  packageThreePriceCents  Int @default(30000)
  packageFivePriceCents   Int @default(48000)
  packageTenPriceCents    Int @default(90000)

  fittingDriverEnabled Boolean @default(true)
  fittingIronEnabled   Boolean @default(true)
  fittingFullEnabled   Boolean @default(true)

  fittingDriverPriceCents Int @default(8000)
  fittingIronPriceCents   Int @default(10000)
  fittingFullPriceCents   Int @default(20000)

  // If enabled, players can reserve a lesson package without paying online
  // and settle up in person at their first lesson instead. Off by default —
  // this is a deliberate business risk tradeoff (no-show/non-payment risk
  // vs. lower booking friction), so each business opts in explicitly.
  allowPayLater Boolean @default(false)
  // A genuinely different thing from a deposit - no money moves through
  // the app at all here, since a club or the owner is billing the
  // player separately, outside the app entirely. Both sides need to see
  // this clearly labeled as such, not mistaken for "pay in person."
  allowClubBilling Boolean @default(false)

  // If enabled, new bookings are held as "pending" until the instructor
  // confirms or denies them, instead of being confirmed immediately.
  requireBookingApproval Boolean @default(true)
  bookingWindowDays Int @default(28) // how far ahead players can see/pick open slots

  // Which calendar system the instructor's sync connects to. Google is the
  // default for backward compatibility with businesses that connected
  // before Outlook support existed.
  calendarProvider String @default("google") // "google" | "outlook"

  // Email alert sent to the instructor whenever a booking happens — both
  // instant-confirmed bookings and pending requests trigger one. Off by
  // default. Falls back to the business's public `email` field if
  // notificationEmail isn't set separately.
  notifyOnBooking  Boolean @default(false)
  notificationEmail String?
  // Who actually gets emailed when a booking comes in - a real gap
  // before this existed: the email always went to this business-wide
  // address regardless of which specific instructor a booking was
  // actually with, so a second instructor never heard about their own
  // bookings at all.
  bookingNotifyTarget String @default("owner") // "instructor" | "owner" | "both"

  memberships  Membership[]
  availability Availability[]
  bookings     Booking[]
  packages     Package[]
  playingLessonRequests PlayingLessonRequest[]
  conversations Conversation[]
  swingSessions SwingSession[]
  syncLogs     SyncLog[]
  videoSubmissions VideoSubmission[]
  swingSketches SwingSketch[]
  products     Product[]
  orders       Order[]
  giftCards    GiftCard[]
  // Daily.co API key for remote/video-call lessons — same "bring your own
  // account" pattern as Stripe Connect, Square, and Google/Outlook
  // Calendar. Never sent to the client; only used server-side to create
  // call rooms when a remote booking is confirmed.
  dailyApiKey  String?
  // Find a Pro directory — opt-in, not automatic. Some instructors build
  // their following entirely through their own shared link and may not
  // want to be discoverable by strangers browsing a public directory, so
  // this defaults to off rather than listing every business by default.
  // Find a Pro directory - opt-in, not automatic. Some instructors build
  // their following entirely through their own shared link and may not
  // want to be discoverable by strangers browsing a public directory, so
  // this defaults to off rather than listing every business by default.
  listedInDirectory Boolean @default(false)
  city              String?
  state             String?
  zipCode           String?
  // Geocoded once when city/state/zip is saved (see lib/geocoding.ts) -
  // lets Find a Pro do genuine distance-based search ("within 25 miles")
  // instead of exact text matching. Null until geocoding succeeds, which
  // just means this business falls back to not showing up in a radius
  // search until it's set - text search elsewhere isn't affected.
  latitude          Float?
  longitude         Float?
  createdAt    DateTime @default(now())
}

// Links a person (global User) to a business with a role. A single Google
// login can be a player at one business and the owner/instructor at another —
// role and history are always scoped to a specific business via this table.
model Membership {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  role       String   // "owner" | "instructor" | "player"
  // "active" for every normal membership (the default, matching every
  // existing row). "pending" is specifically for someone who requested to
  // join as an instructor and hasn't been approved yet - requireMembership()
  // below treats a pending membership as if it doesn't exist for any
  // access check, so a pending request never grants real instructor
  // access on its own, only the actual approval does.
  status     String   @default("active")
  specialty  String?  // short tagline shown to players, e.g. "Short game, junior coaching" — only meaningful for owner/instructor roles
  // Keeps this person out of the player-facing booking picker without
  // touching their own access to the app at all - unlike status
  // "inactive" (which also blocks their own Settings/calendar access),
  // this is purely about whether players can see and book with them.
  // For test/demo instructor accounts, internal-only staff, etc.
  hiddenFromBooking Boolean @default(false)

  // Google Calendar sync token — set when this member (as an instructor)
  // connects their calendar for this specific business.
  googleRefreshToken String?

  // Outlook/Microsoft 365 equivalent. Unlike Google (where the googleapis
  // client refreshes access tokens internally from just the refresh token),
  // Microsoft Graph access tokens expire quickly (~1hr) and must be
  // refreshed and re-persisted explicitly — see lib/outlook.ts.
  outlookAccessToken    String?
  outlookRefreshToken   String?
  outlookTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  // @default(now()) is required here, not just @updatedAt alone - without
  // it, this migration has no value to give the rows that already exist,
  // and Prisma refuses to apply it (would otherwise require resetting the
  // whole database). New rows get "now" as their initial value the same
  // as createdAt above, then this auto-updates on every future change.
  updatedAt DateTime @default(now()) @updatedAt
  assignedBookings Booking[]
  soldPackages Package[]
  availability Availability[]
  videoSubmissions VideoSubmission[]
  swingSketches SwingSketch[]
  pushSubscriptions PushSubscription[]
  fcmTokens         FcmToken[]
  conversationsAsPlayer Conversation[]
  sentMessages          Message[]
  aiAnalysisPreferences AiAnalysisPreference[]
  lessonDurations       LessonDuration[]
  playingLessonRequestsAsInstructor PlayingLessonRequest[] @relation("PlayingLessonRequestInstructor")

  // Per-instructor pricing — each instructor on staff sets their own rates,
  // rather than one shared business-wide price. Mirrors the exact same
  // field names as Business's own pricing fields (see below) on purpose:
  // lib/pricing.ts's helpers are untyped (Record<string, any>), so passing
  // a Membership object works identically to passing a Business object,
  // no separate code path needed. Defaults match Business's defaults, so a
  // newly added instructor starts with sensible pricing rather than
  // everything disabled/unpriced.
  packageSingleEnabled Boolean @default(true)
  packagePlayingEnabled Boolean @default(true)
  packageVideoEnabled  Boolean @default(true)
  packageThreeEnabled  Boolean @default(true)
  packageFiveEnabled   Boolean @default(true)
  packageTenEnabled    Boolean @default(true)

  packageSinglePriceCents Int @default(12000)
  packagePlayingPriceCents Int @default(0) // 0 = "TBD" — not yet priced by the instructor
  packageVideoPriceCents  Int @default(0) // 0 = "TBD" — open price, same convention as Playing lesson
  packageThreePriceCents  Int @default(30000)
  packageFivePriceCents   Int @default(48000)
  packageTenPriceCents    Int @default(90000)

  fittingDriverEnabled Boolean @default(true)
  fittingIronEnabled   Boolean @default(true)
  fittingFullEnabled   Boolean @default(true)

  fittingDriverPriceCents Int @default(8000)
  fittingIronPriceCents   Int @default(10000)
  fittingFullPriceCents   Int @default(20000)

  // Playing lessons - out on the course with the student, 9 or 18 holes.
  // Deliberately separate from LessonDuration (which is minutes-based):
  // a playing lesson runs 2-4+ hours and isn't a fixed-length calendar
  // slot the way a regular lesson is, so it's request-based rather than
  // self-service booked - see PlayingLessonRequest below.
  playingLesson9Enabled    Boolean @default(false)
  playingLesson9PriceCents  Int    @default(0)
  playingLesson18Enabled   Boolean @default(false)
  playingLesson18PriceCents Int   @default(0)

  // Four open, instructor-defined pricing slots - anything that doesn't
  // fit the fixed package/fitting categories above (a specific lesson
  // length, an annual option, a bundle they invented themselves). A slot
  // is considered active whenever it has a name - no separate enabled
  // flag needed, since an empty name already means "not using this one."
  customOffering1Name       String?
  customOffering1PriceCents Int?
  customOffering2Name       String?
  customOffering2PriceCents Int?
  customOffering3Name       String?
  customOffering3PriceCents Int?
  customOffering4Name       String?
  customOffering4PriceCents Int?

  @@unique([userId, businessId])
}

// A lesson length an instructor offers - e.g. "30 min", "45 min", "60
// min" - fully instructor-defined rather than a fixed platform tier,
// since different instructors run genuinely different lesson lengths.
// Deliberately doesn't affect the calendar/availability system at all -
// every lesson, regardless of which duration was purchased, still books
// into the same standard hourly slot. This is purely a pricing and
// labeling dimension layered on top of that, not a scheduling one.
model LessonDuration {
  id           String     @id @default(cuid())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String
  minutes      Int
  // Optional name for this specific offering - e.g. "Putting Lesson" or
  // "Chipping Lesson" - so an instructor can offer several distinct
  // lesson types, even ones that happen to share the same length,
  // rather than being limited to duration as the only distinguishing
  // factor. Left blank, it's just a generic lesson at this length.
  label        String?
  singlePriceCents Int
  remoteEnabled Boolean   @default(true) // can a lesson at this duration be booked as a remote/video lesson too
  sortOrder    Int        @default(0)
  packages     LessonPackageOption[]
  createdAt    DateTime   @default(now())
}

// A package size nested under one specific duration - e.g. a "5-pack"
// of 45-minute lessons. lessonsCount is fully custom per instructor
// (not a fixed 3/5/10), and priced independently from the duration's
// own single-lesson rate.
model LessonPackageOption {
  id           String         @id @default(cuid())
  duration     LessonDuration @relation(fields: [durationId], references: [id], onDelete: Cascade)
  durationId   String
  lessonsCount Int
  priceCents   Int
  sortOrder    Int            @default(0)
}

// A player's request for a playing lesson (9 or 18 holes out on the
// course) - request-based rather than self-service booked, since the
// actual time needs real coordination (tee time, course availability)
// that the regular hourly-slot calendar isn't built for. The instructor
// follows up and books the actual lesson manually once arranged.
model PlayingLessonRequest {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  instructor   Membership @relation("PlayingLessonRequestInstructor", fields: [instructorMembershipId], references: [id])
  instructorMembershipId String
  player       User     @relation(fields: [playerId], references: [id])
  playerId     String
  holes        Int      // 9 or 18
  priceCents   Int      // snapshot of the instructor's price at request time
  preferredDate DateTime?
  notes        String?
  // "pending" until the instructor has followed up and manually booked
  // (or declined) the actual lesson - this only tracks whether the
  // request itself has been handled, not a real booking's lifecycle.
  status       String   @default("pending")
  contactName  String?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())
}

// --- Identity (global — not tenant-scoped) ---

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?    // required by NextAuth's Prisma adapter, even though this app doesn't use email-verification sign-in
  image          String?
  phone          String?
  emailReminders Boolean      @default(true)
  textReminders  Boolean      @default(true)
  reminderHours  Int          @default(24)
  // Golf profile — filled in once by the player, visible to the instructor
  // on every booking (not booking-specific, since these don't change visit
  // to visit).
  handedness     String?      // "right" | "left"
  scoreOrHandicap String?
  commonIssues   String?
  memberships    Membership[]
  packages       Package[]
  playingLessonRequests PlayingLessonRequest[]
  bookings       Booking[]
  videoSubmissions VideoSubmission[]
  swingSketches SwingSketch[]
  orders         Order[]
  giftCardsPurchased GiftCard[] @relation("PurchasedGiftCards")
  aiAnalysisPreferences AiAnalysisPreference[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime     @default(now())
}

// --- Business-scoped data ---

model Package {
  id               String    @id @default(cuid())
  business         Business  @relation(fields: [businessId], references: [id])
  businessId       String
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  // Which instructor this package's credits are for — pricing is now
  // per-instructor, so a package is really "N lessons with this specific
  // person at their rate," not a generic credit any instructor can redeem.
  // Nullable for backward compatibility with packages that predate this field.
  instructor       Membership? @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId String?
  type             String    // single | three | five | ten | duration (this last one is the new, instructor-defined lesson-length system)
  // A snapshot of the lesson length purchased, only set for type "duration" -
  // captured at purchase time so it stays accurate even if the instructor
  // later edits or removes the LessonDuration it came from.
  durationMinutes  Int?
  durationLabel    String?
  lessonsTotal     Int
  lessonsRemaining Int
  pricePaidCents   Int       // the full listed price of this package, before any credit
  creditCents      Int       @default(0) // amount credited from a prior package when upgrading (e.g. single -> 3-pack)
  upgradedFromId   String?   // the package this one replaced, if created via an upgrade
  paymentStatus    String    @default("paid") // "paid" | "pending" (older, zero-upfront pay-later, kept for backward compatibility) | "deposit_paid" (half now, rest at the lesson)
  // How much is still owed on this package - 0 once it's fully paid off.
  // For a deposit package, this starts at half the price and is what
  // actually needs collecting in person at the first lesson.
  balanceDueCents  Int       @default(0)
  paidAt           DateTime?
  stripeSessionId  String?
  squareOrderId    String?
  createdAt        DateTime  @default(now())
  bookings         Booking[]
}

model Availability {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id])
  businessId     String
  // Each instructor has their own independent timeline now — two
  // instructors can be booked at the same startTime, each with a different
  // student, since they're two different people. (Calendar sync stays
  // shared/single regardless — see lib/calendar.ts — this is purely about
  // who's free when.)
  instructor     Membership @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId String
  startTime      DateTime
  status         String   @default("open") // open | closed | booked | full
  // Lets an instructor override the 24-hour minimum lead time for one
  // specific slot - e.g. a same-day cancellation they want to reopen for
  // any player to grab, without turning off the protection everywhere else.
  allowLastMinute Boolean @default(false)
  // Group lessons - designated from a normal open slot rather than being a
  // separate kind of slot from the start. groupPriceCents is set fresh each
  // time (not a fixed rate from Settings), since group pricing varies a lot
  // by event - a junior camp vs. an adult clinic vs. a one-off group session.
  isGroup         Boolean @default(false)
  groupCapacity   Int?
  groupPriceCents Int?
  // "men" | "ladies" | "junior_younger" | "junior_older" - a fixed set
  // rather than free text, so the booking page can offer real filtering.
  groupCategory   String?
  // Free text, only meaningful when groupCategory is one of the junior
  // types - exact age brackets vary by program, so this stays flexible
  // rather than being baked into the category itself.
  groupAgeRange   String?
  closedReason   String?  // "manual" | "calendar"
  blockedEventId String?
  // A list, not a single optional booking, since a group slot can hold
  // several bookings at once (one per player who's joined) - a private
  // lesson slot just happens to only ever have one.
  bookings       Booking[]

  @@unique([businessId, instructorMembershipId, startTime])
}

model Booking {
  id                    String        @id @default(cuid())
  business              Business      @relation(fields: [businessId], references: [id])
  businessId            String
  player                User          @relation(fields: [playerId], references: [id])
  playerId              String
  // Which staff member (owner or instructor role) is delivering this
  // session — the business still has one shared timeline (a slot is either
  // open or booked, same as always), this just records who it's with,
  // since a business can now have more than one instructor on staff.
  instructor            Membership?   @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId String?
  serviceType           String        // lesson | fitting
  fittingType           String?       // driver | iron | full
  // Remote lessons — only meaningful when serviceType is "lesson". The
  // video call room is created once the booking is confirmed (same moment
  // calendar sync happens), not at booking time, so a pending request
  // doesn't spin up a room before anyone's actually agreed to meet.
  isRemote              Boolean       @default(false)
  videoCallUrl          String?
  startTime             DateTime
  status                String        @default("confirmed") // confirmed | cancelled
  priceCents            Int
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  package               Package?      @relation(fields: [packageId], references: [id])
  packageId             String?
  stripeSessionId       String?
  squareOrderId         String?
  googleCalendarEventId String?
  availability          Availability? @relation(fields: [availabilityId], references: [id])
  // No longer unique - a group lesson slot can have several bookings
  // pointing at it at once, one per player who's joined that session.
  availabilityId        String?
  note                  Note?
  swingSketches         SwingSketch[]
  giftCardRedemptions   GiftCardRedemption[]
  createdAt             DateTime      @default(now())
}

// Swing analysis: a player submits a video, the instructor reviews it and
// leaves comments pinned to specific moments in the footage. This is
// deliberately timestamped text comments rather than frame-by-frame visual
// annotation (drawing lines on the video) — a real, useful v1 without the
// much larger scope a full annotation tool would take on.
// Links two separately-recorded videos of the same swing together - one
// device creates a session and gets a short code, a second device
// (typically mounted down the target line, while the first is face-on)
// joins using that code. Each device uploads independently through the
// same existing video upload flow, just tagged with this session and
// its own angle, rather than needing true, frame-perfect hardware sync
// between two phones, which would be a much bigger, riskier thing to
// build for the same real coaching value.
model SwingSession {
  id                     String    @id @default(cuid())
  business               Business  @relation(fields: [businessId], references: [id])
  businessId             String
  createdByUserId        String
  // Short, easy to read aloud/type on a second phone - not a full cuid.
  joinCode               String    @unique
  instructorMembershipId String
  playerId               String
  videos                 VideoSubmission[]
  createdAt              DateTime  @default(now())
}

model VideoSubmission {
  id                      String    @id @default(cuid())
  business                Business  @relation(fields: [businessId], references: [id])
  businessId              String
  player                  User      @relation(fields: [playerId], references: [id])
  playerId                String
  instructor              Membership @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId  String
  videoUrl                String
  title                   String?   // e.g. "Driver, face-on"
  playerNote              String?   // context the player adds when submitting, e.g. "slicing lately"
  status                  String    @default("pending") // pending | reviewed
  submittedAt             DateTime  @default(now())
  reviewedAt              DateTime?
  comments                VideoComment[]
  // Set only for a video that's part of a two-camera session - null for
  // every normal, single-angle submission, which is still the common case.
  swingSession            SwingSession? @relation(fields: [swingSessionId], references: [id])
  swingSessionId          String?
  angle                   String?   // "down_the_line" | "face_on" - only meaningful when swingSessionId is set
}

model VideoComment {
  id                String          @id @default(cuid())
  submission        VideoSubmission @relation(fields: [submissionId], references: [id])
  submissionId      String
  timestampSeconds  Float           // where in the video this comment applies
  text              String
  createdAt         DateTime        @default(now())
}

// Swing Sketch: an instructor draws directly on a photo/frame (lines,
// angles, arrows, circles, labels) to illustrate a swing position —
// deliberately separate from swing video review above. That's a player
// Per-relationship opt-in for AI-assisted pose detection in Swing Sketch -
// deliberately scoped to one specific (instructor, player) pair rather
// than a single business-wide or per-instructor switch, since a player
// might be fine with it for one instructor but not another, and an
// instructor might want it on for some students and not others.
// Missing row = off (the default) - a row only ever exists once someone
// has actually turned it on for that pair.
model AiAnalysisPreference {
  id                     String     @id @default(cuid())
  instructor             Membership @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId String
  player                 User       @relation(fields: [playerId], references: [id])
  playerId               String
  enabled                Boolean    @default(false)
  updatedAt              DateTime   @updatedAt

  @@unique([instructorMembershipId, playerId])
}

// submitting a clip for the instructor to comment on; this is the
// instructor actively marking up a still image, usually live in a lesson.
model SwingSketch {
  id                      String     @id @default(cuid())
  business                Business   @relation(fields: [businessId], references: [id])
  businessId              String
  player                  User       @relation(fields: [playerId], references: [id])
  playerId                String
  instructor              Membership @relation(fields: [instructorMembershipId], references: [id])
  instructorMembershipId  String
  booking                 Booking?   @relation(fields: [bookingId], references: [id])
  bookingId               String?
  imageUrl                String     // the flattened, annotated PNG
  sourceUrl               String?    // the original unmarked photo, kept so it can be re-edited later
  shapesJson              String     // raw shapes array as JSON — what actually makes it re-editable, not just a flat image
  label                   String?    // e.g. "Impact position", "Top of backswing"
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([businessId])
  @@index([playerId])
  @@index([bookingId])
}

// --- Shop: real inventory (clubs, apparel, accessories) ---
// Deliberately kept simple for v1: one price per product, optional
// lightweight variants (size, flex, etc.) that only differ by label and
// stock count — not per-variant pricing. Good enough for how a single-
// location pro shop actually sells; a full variant-pricing matrix would
// be real added complexity most small shops don't need.
model Product {
  id          String            @id @default(cuid())
  business    Business          @relation(fields: [businessId], references: [id])
  businessId  String
  name        String
  description String?
  category    String?           // freeform — "Clubs", "Apparel", "Accessories", etc.
  imageUrl    String?
  priceCents  Int
  enabled     Boolean           @default(true)
  // Stock lives here directly for products with no variants. Products
  // WITH variants track stock per-variant instead (see below) — this
  // field is ignored for those, kept only so a variant-less product
  // doesn't need a dummy variant just to have a stock count.
  stockQuantity Int?
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId])
}

model ProductVariant {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id])
  productId     String
  label         String      // e.g. "Men's L", "Right-handed, Stiff flex", "10.5°"
  stockQuantity Int         @default(0)
  orderItems    OrderItem[]

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  business        Business    @relation(fields: [businessId], references: [id])
  businessId      String
  buyer           User        @relation(fields: [buyerId], references: [id])
  buyerId         String
  status          String      @default("pending") // pending | paid | fulfilled | cancelled
  fulfillmentType String      // "pickup" | "shipping"
  shippingName    String?
  shippingAddress String?
  contactPhone    String?
  contactEmail    String?
  totalCents      Int
  giftCardAppliedCents Int    @default(0) // portion of the total covered by a gift card, if any
  stripeSessionId String?
  items           OrderItem[]
  giftCardRedemptions GiftCardRedemption[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([businessId])
  @@index([buyerId])
}

model OrderItem {
  id                   String          @id @default(cuid())
  order                Order           @relation(fields: [orderId], references: [id])
  orderId              String
  product              Product         @relation(fields: [productId], references: [id])
  productId            String
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  variantId            String?
  quantity             Int
  priceCentsAtPurchase Int             // snapshot at purchase time — price changes later shouldn't rewrite old orders

  @@index([orderId])
}

// --- Gift cards ---
// A stored balance, not a fixed voucher — can be partially redeemed
// across more than one purchase (e.g. $50 card used $30 on a lesson
// package, $20 later on a shop order), same as how gift cards actually
// work at most real businesses.
model GiftCard {
  id                  String   @id @default(cuid())
  business            Business @relation(fields: [businessId], references: [id])
  businessId          String
  code                String   @unique // redemption code, e.g. "TTG-4F2K-9XQP"
  initialValueCents   Int
  remainingValueCents Int
  purchasedBy         User?    @relation("PurchasedGiftCards", fields: [purchasedByUserId], references: [id])
  purchasedByUserId   String?
  recipientName       String?
  recipientEmail      String?
  message             String?
  stripeSessionId     String?
  status              String   @default("active") // active | depleted | expired
  createdAt           DateTime @default(now())
  redemptions         GiftCardRedemption[]

  @@index([businessId])
}

// A single browser/device that's granted notification permission. One
// membership can have multiple (phone + laptop, say) - each gets its own
// row and its own push, since a subscription is tied to one specific
// browser's push service registration, not to the person in the abstract.
model PushSubscription {
  id           String     @id @default(cuid())
  membership   Membership @relation(fields: [membershipId], references: [id])
  membershipId String
  endpoint     String     @unique
  p256dh       String
  auth         String
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

// A device token for native push notifications (via Firebase Cloud
// Messaging), used only inside the wrapped Android/iOS app - kept as its
// own model rather than reusing PushSubscription, since FCM's shape (one
// simple token) is structurally different from a web push subscription
// (endpoint + two separate keys). sendPushToMembership sends to both
// kinds together, so the rest of the app never needs to know which one
// a given person is using.
model FcmToken {
  id           String     @id @default(cuid())
  membership   Membership @relation(fields: [membershipId], references: [id])
  membershipId String
  token        String     @unique
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id])
  giftCardId  String
  amountCents Int
  booking     Booking? @relation(fields: [bookingId], references: [id])
  bookingId   String?
  order       Order?   @relation(fields: [orderId], references: [id])
  orderId     String?
  redeemedAt  DateTime @default(now())

  @@index([giftCardId])
}

model Note {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @unique
  text      String
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id              String   @id @default(cuid())
  business        Business @relation(fields: [businessId], references: [id])
  businessId      String
  ranAt           DateTime @default(now())
  success         Boolean
  bookingsCreated Int      @default(0)
  slotsBlocked    Int      @default(0)
  slotsUnblocked  Int      @default(0)
  message         String?
  triggeredBy     String   @default("manual") // "manual" | "cron"
}

// Square's Order reference_id is too short to carry full checkout metadata
// the way Stripe's session.metadata does, so a pending payment's details are
// stashed here first — this record's id becomes the reference_id sent to
// Square, and the webhook looks the details back up by that id. Consumed
// (deleted) once the webhook successfully processes the payment; stale
// unconsumed rows (abandoned checkouts) can be purged periodically.
model PendingSquarePayment {
  id            String   @id @default(cuid())
  businessId    String
  userId        String
  kind          String   // "package" | "fitting" | "group"
  packageType   String?
  // Only set for the new, instructor-defined lesson-length system (see
  // LessonDuration/LessonPackageOption) - packageType is "duration" in
  // that case, and these two carry the rest of what's actually needed.
  packageOptionId String?
  durationMinutes Int?
  durationLabel   String?
  lessonsTotal    Int?
  availabilityId String?
  fittingType   String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  instructorMembershipId String?
  isRemote      Boolean  @default(false)
  // Only set for a deposit payment - the full package price, separate
  // from the (smaller) amount actually being charged right now, so the
  // webhook can work out the real remaining balance once payment
  // succeeds.
  fullPriceCents Int?
  createdAt     DateTime @default(now())
}

// --- NextAuth required models (global — a login is not tenant-scoped) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A short-lived, one-time handoff for the native app's Apple sign-in flow.
// The web-based OAuth flow (Apple's own sign-in screen, then NextAuth's
// callback) runs entirely in the system browser, where a real session
// already gets created normally - but that session cookie lives in the
// system browser's own cookie jar, not the app's separate embedded one.
// This row is the bridge: a random, single-use token pointing at that
// real session, created right after sign-in succeeds and redeemed once
// the native app (reached via a Universal Link) makes its own request to
// /api/auth/redeem-native-token from inside its own web view - only then
// does the session cookie actually land where the app can see it. Expires
// in minutes, and is deleted the moment it's redeemed, so it's only ever
// usable for the single handoff it exists for.
model NativeAuthHandoff {
  token        String   @id @default(cuid())
  sessionToken String
  // Where the person was actually trying to go before landing on /login
  // in the first place - carried through here rather than threaded
  // across several URL-encoded query params over multiple redirect hops.
  callbackUrl  String   @default("/")
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One thread per player per business, visible to every instructor/owner
// at that business - not a separate thread per instructor, since a
// small business's players naturally think of themselves as messaging
// "the business," not a specific person, and this keeps things simple
// for the common case of one or two instructors sharing the same inbox.
model Conversation {
  id                 String   @id @default(cuid())
  business           Business @relation(fields: [businessId], references: [id])
  businessId         String
  playerMembership   Membership @relation(fields: [playerMembershipId], references: [id])
  playerMembershipId String
  messages           Message[]
  lastMessageAt      DateTime @default(now()) // drives sort order in the conversation list - updated every time a new message comes in, so the most recently active thread always sorts first
  createdAt          DateTime @default(now())

  @@unique([businessId, playerMembershipId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         Membership   @relation(fields: [senderMembershipId], references: [id])
  senderMembershipId String
  body           String?
  imageUrl       String? // set for an image message, alongside or instead of body text
  readAt         DateTime? // null until the recipient actually opens the thread - drives the unread indicator
  createdAt      DateTime     @default(now())
}
